# Contact form (Formspree form ID) and optional reCAPTCHA v2 site key.
NEXT_PUBLIC_FORMSPREE_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Footer visitor count. VERCEL_PROJECT_ID is set automatically on Vercel deployments.
VERCEL_API_TOKEN=

# Keystatic content editor (/keystatic) on the live site. Created by Keystatic's GitHub App
# setup; see "Enabling the editor on the live site" in the README. Not needed for pnpm dev.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
